# Copy to .env next to docker-compose.yml and fill in real values.

# Database password (generate: openssl rand -hex 24)
POSTGRES_PASSWORD=change-me

# JWT signing secret (generate: openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-string

# Public origin of the app once behind TLS, e.g. https://crm.example.com
# Used for CORS. Leave * only for private/testing deployments.
PUBLIC_ORIGIN=*

# Host port for the web UI
WEB_PORT=8080

# Optional SMTP for email notifications / workflow send_email actions
# SMTP_URL=smtp://user:pass@smtp.example.com:587
SMTP_FROM="NimbusCRM <no-reply@example.com>"

MAX_UPLOAD_MB=10
