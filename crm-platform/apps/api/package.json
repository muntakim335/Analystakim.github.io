{
  "name": "@nimbuscrm/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NimbusCRM backend API",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --target node22 --clean --sourcemap --external @electric-sql/pglite",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate-cli.ts",
    "demo": "tsx scripts/dev-pglite.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "bcryptjs": "^3.0.2",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "fastify": "^5.2.0",
    "nodemailer": "^6.10.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
